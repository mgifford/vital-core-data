  Get your feet checked at every health care visit and visit your foot doctor at least once a year.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":299,"renderedHeight":168,"naturalWidth":2500,"naturalHeight":1406,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 567 characters — consider a caption or description","bytes":755599},{"src":"https://cdc.govprojectOPHSS_CSELS_DPHID_MMWR_OD_EditorsMMWR-WECURRENT%20-%20May%2017Final%20to%20XMLbjx5@www.cdc.gov/diabetes/images/library/337438-a_footcare_infographic_3.10_final.jpg","alt":"Tips for Healthy Feet (larger version)","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":299,"renderedHeight":168,"naturalWidth":2500,"naturalHeight":1406,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":757211},{"src":"https://cdc.govprojectOPHSS_CSELS_DPHID_MMWR_OD_EditorsMMWR-WECURRENT%20-%20May%2017Final%20to%20XMLbjx5@www.cdc.gov/TemplatePackage/5.0/img/logo/cdc-logo-tag-right.svg","alt":"Centers for Disease Control and Prevention","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":282,"renderedHeight":66,"naturalWidth":827,"naturalHeight":193,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":4780}]},"standards":{"engine":"standards","checks":[{"id":"schema-gov","label":"schema.org GovernmentOrganization markup","pass":false,"detail":""},{"id":"canonical","label":"Canonical URL declared","pass":true,"detail":""},{"id":"hreflang","label":"hreflang alternates declared","pass":false,"detail":""},{"id":"title","label":"Page has a <title>","pass":true,"detail":""},{"id":"description","label":"Meta description present","pass":true,"detail":""},{"id":"charset","label":"Character encoding declared","pass":true,"detail":""},{"id":