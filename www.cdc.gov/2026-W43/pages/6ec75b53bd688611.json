 group. Despite the declines among all groups, teenage birth rates by race/ethnicity continue to reflect wide disparities.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":582,"renderedHeight":379,"naturalWidth":582,"naturalHeight":379,"loading":null,"decoding":null,"altVerdict":"TOO_LONG","altReason":"alt text is 703 characters — consider a caption or description","bytes":11259},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_pdf.gif","alt":"Adobe PDF file","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":16,"renderedHeight":16,"naturalWidth":16,"naturalHeight":16,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":6058},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_pdf.gif","alt":"Adobe PDF file","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":16,"renderedHeight":16,"naturalWidth":16,"naturalHeight":16,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":6058},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_word.gif","alt":"Microsoft Word file","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":16,"renderedHeight":16,"naturalWidth":16,"naturalHeight":16,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":1087},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_excel.gif","alt":"Microsoft Excel file","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":16,"renderedHeight":16,"naturalWidth":16,"naturalHeight":16,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":644},{"src":"https://www.cdc.gov/TemplatePackage/images/icon_ppt.gif","alt":"Micr