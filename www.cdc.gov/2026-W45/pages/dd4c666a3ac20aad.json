%26#37; or lower) are in north-central Illinois. Sources: Centers for Disease Control and Prevention: diagnosed diabetes prevalence, 2013. Illinois Department of Public Health: 2017 licensed health care centers of Illinois and rural health care centers of Illinois. Illinois Pathways to Health database, Chronic Disease Self-Management Education Program Workshop locations.","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":1110,"renderedHeight":243,"naturalWidth":null,"naturalHeight":null,"loading":null,"decoding":"async","altVerdict":"TOO_LONG","altReason":"alt text is 1168 characters — consider a caption or description","bytes":20905},{"src":"https://www.cdc.gov/TemplatePackage/5.0/img/logo/cdc-logo-tag-right.svg","alt":"Centers for Disease Control and Prevention","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":283,"renderedHeight":66,"naturalWidth":827,"naturalHeight":193,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":4780},{"src":"https://www.cdc.gov/TemplatePackage/contrib/libs/cdc/c2r/crlogo.svg","alt":"Content Credentials logo","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":25,"renderedHeight":150,"naturalWidth":150,"naturalHeight":150,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":1490}]},"standards":{"engine":"standards","checks":[{"id":"schema-gov","label":"schema.org GovernmentOrganization markup","pass":false,"detail":""},{"id":"canonical","label":"Canonical URL declared","pass":true,"detail":""},{"id":"hreflang","label":"hreflang alternates declared","pass":false,"detail":""},{"id":"title","label":"Page has a <title>","pass":true,"detail":""},{"id":"description","label":"Meta description present","pass":true,"detail":""},{"id":"charset","label":"Character encodi